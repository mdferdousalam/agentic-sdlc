#!/usr/bin/env python3
"""sdlc — the machine half of the agentic SDLC pipeline.

The agents are prose: they persuade a model. This is the part that does not negotiate. It
detects the project, records each stage's verdict as a receipt bound to a commit and a clock,
and — as a PreToolUse hook — refuses the actions that would skip a stage.

    sdlc init [--write]          detect the stack and write sdlc.config.json
    sdlc config                  print the effective configuration
    sdlc receipt write KIND --verdict V [--subject S] [--detail D]
    sdlc receipt check KIND [--verdict V] [--max-age-min N]
    sdlc receipt show  KIND
    sdlc status                  where this unit of work stands
    sdlc guard                   PreToolUse hook: reads tool JSON on stdin, exit 2 blocks
    sdlc doctor                  check the install, the config and the repo

Python 3.8+, standard library only, no network. Exit codes: 0 fine, 1 a check failed,
2 blocked (the hook contract), 3 misuse.
"""
from __future__ import annotations

import argparse
import calendar
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

CONFIG_NAMES = ("sdlc.config.json", ".opencode/sdlc.json")
RECEIPT_DIR = ".sdlc/receipts"
RECEIPT_KINDS = ("spec", "verification", "review", "security", "quality", "gate",
                 "readiness", "approval_merge", "approval_release", "approval_exception",
                 "release", "postdeploy")
AUDIT_LOG = ".sdlc/audit.log"
FEEDBACK = ".sdlc/feedback.json"
DEFAULT_MAX_AGE_MIN = 180

# --------------------------------------------------------------------------------------- git


def git(*args: str, cwd: str | None = None) -> str:
    try:
        p = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=20)
        return p.stdout.strip()
    except Exception:
        return ""


def repo_root(start: str | None = None) -> str:
    r = git("rev-parse", "--show-toplevel", cwd=start or os.getcwd())
    return r or (start or os.getcwd())


def head(root: str) -> str:
    return git("rev-parse", "HEAD", cwd=root)


def branch(root: str) -> str:
    return git("rev-parse", "--abbrev-ref", "HEAD", cwd=root)


def tree_clean(root: str) -> bool:
    return git("status", "--porcelain", "--untracked-files=no", cwd=root) == ""


# ------------------------------------------------------------------------------------ config


def exists(root: str, *names: str) -> bool:
    return any(os.path.exists(os.path.join(root, n)) for n in names)


def which(name: str) -> bool:
    return shutil.which(name) is not None


def config_path(root: str) -> str | None:
    for n in CONFIG_NAMES:
        p = os.path.join(root, n)
        if os.path.exists(p):
            return p
    return None


def load_config(root: str) -> dict:
    p = config_path(root)
    if not p:
        return {}
    try:
        return json.load(open(p))
    except Exception as e:
        print(f"sdlc: {p} is not valid JSON: {e}", file=sys.stderr)
        return {}


def detect_trunk(root: str) -> str:
    ref = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=root)
    if ref:
        return ref.split("/")[-1]
    for cand in ("main", "master", "develop", "Development"):
        if git("rev-parse", "--verify", "--quiet", f"refs/heads/{cand}", cwd=root):
            return cand
    return branch(root) or "main"


def detect(root: str) -> dict:
    """Infer the project's bindings. Everything here is a guess the user may correct."""
    pm = monorepo = None
    stack = "unknown"
    test = {}
    verify = []

    if exists(root, "pnpm-lock.yaml"):
        pm = "pnpm"
    elif exists(root, "yarn.lock"):
        pm = "yarn"
    elif exists(root, "bun.lockb", "bun.lock"):
        pm = "bun"
    elif exists(root, "package-lock.json"):
        pm = "npm"
    elif exists(root, "package.json"):
        pm = "npm"

    if pm:
        stack = "node"
        monorepo = ("turbo" if exists(root, "turbo.json") else
                    "nx" if exists(root, "nx.json") else
                    "lerna" if exists(root, "lerna.json") else
                    "workspaces" if exists(root, "pnpm-workspace.yaml") else None)
        pkg = {}
        try:
            pkg = json.load(open(os.path.join(root, "package.json")))
        except Exception:
            pass
        deps = {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
        scripts = pkg.get("scripts", {})
        for runner in ("vitest", "jest", "mocha", "ava", "node:test"):
            if runner.split(":")[0] in deps:
                test["unit"] = runner
                break
        for e2e in ("playwright", "@playwright/test", "cypress"):
            if e2e in deps:
                test["e2e"] = e2e.replace("@playwright/test", "playwright")
                break
        for s in ("lint", "typecheck", "type-check", "test"):
            if s in scripts:
                verify.append(f"{pm} run {s}" if s != "test" else f"{pm} test")
    elif exists(root, "Cargo.toml"):
        stack, pm = "rust", "cargo"
        test["unit"] = "cargo test"
        verify = ["cargo fmt --all -- --check",
                  "cargo clippy --all-targets --all-features -- -D warnings",
                  "cargo test --workspace"]
    elif exists(root, "go.mod"):
        stack, pm = "go", "go"
        test["unit"] = "go test"
        verify = ["gofmt -l .", "go vet ./...", "go test ./..."]
    elif exists(root, "pyproject.toml", "setup.cfg", "requirements.txt"):
        stack = "python"
        pm = "uv" if exists(root, "uv.lock") else "poetry" if exists(root, "poetry.lock") else "pip"
        test["unit"] = "pytest"
        verify = (["ruff check ."] if exists(root, "ruff.toml") or which("ruff") else []) + ["pytest -q"]
    elif exists(root, "pom.xml"):
        stack, pm, verify = "java", "maven", ["mvn -q verify"]
    elif exists(root, "build.gradle", "build.gradle.kts"):
        stack, pm, verify = "java", "gradle", ["./gradlew check"]
    elif exists(root, "Gemfile"):
        stack, pm, verify = "ruby", "bundler", ["bundle exec rubocop", "bundle exec rspec"]
    elif exists(root, "composer.json"):
        stack, pm, verify = "php", "composer", ["composer test"]
    elif exists(root, "book.toml"):
        stack, verify = "mdbook", ["mdbook build"]
    elif exists(root, "action.yml", "action.yaml"):
        stack = "github-action"

    engine = "openspec" if exists(root, "openspec") or which("openspec") else "prd-frd"

    commits = "conventional" if exists(
        root, "commitlint.config.js", "commitlint.config.cjs", "commitlint.config.mjs",
        ".commitlintrc", ".commitlintrc.json", ".husky") else "descriptive"

    secret_scan = ("gitleaks git --no-banner --redact -n 50" if which("gitleaks")
                   else "trufflehog git file://. --since-commit HEAD~50 --fail" if which("trufflehog")
                   else None)

    cfg = {
        "$schema": "./schema/sdlc.config.schema.json",
        "version": 2,
        "trunk": detect_trunk(root),
        "stack": stack,
        "pm": pm,
        "monorepo": monorepo,
        "commits": commits,
        "test": test,
        "spec": {
            "engine": engine,
            "docsRoot": "openspec/changes" if engine == "openspec" else "docs/specs",
            "strict": True,
        },
        "branchScheme": "{kind}/{slug}",
        "verifyCmd": " && ".join(verify) if verify else None,
        "gateCmd": None,
        "secretScan": secret_scan,
        "heavy": None,
        "profile": None,
        "quality": {
            "cmd": None,
            "coverageNewPct": None,
            "note": "Deterministic analysis on NEW code. Research on agent-written code reports "
                    "rising warnings and complexity, so the budget is on what this change adds, "
                    "not on the whole repository.",
        },
        "release": {
            "deployCmd": None,
            "smokeCmd": None,
            "rollbackCmd": None,
            "environments": [],
        },
        "approvals": {"merge": "agent", "release": "human"},
        "attributeCommits": True,
        "reviewers": ["sdlc-code-reviewer"] + (["sdlc-security-reviewer"] if stack in ("rust", "go", "node", "python", "java") else []),
        "protected": ["main", "master", "release/*"],
        "receipts": {"maxAgeMin": DEFAULT_MAX_AGE_MIN},
        "enforce": {
            "pushToTrunkNeedsGate": True,
            "mergeNeedsReadiness": True,
            "branchNeedsApprovedSpec": True,
            "blockDestructiveGit": True,
            "blockPublishing": True,
            "blockCredentialReads": True,
        },
        "neverByAgent": ["tag", "release", "publish", "force-push", "deploy"],
    }
    return cfg


# ---------------------------------------------------------------------------------- receipts


def receipt_path(root: str, kind: str) -> str:
    return os.path.join(root, RECEIPT_DIR, f"{kind}.json")


def subject_digest(root: str, subject: str) -> str | None:
    if not subject:
        return None
    p = os.path.join(root, subject)
    h = hashlib.sha256()
    if os.path.isfile(p):
        h.update(open(p, "rb").read())
    elif os.path.isdir(p):
        for dirpath, dirnames, names in os.walk(p):
            dirnames.sort()
            for n in sorted(names):
                f = os.path.join(dirpath, n)
                h.update(os.path.relpath(f, p).encode())
                try:
                    h.update(open(f, "rb").read())
                except OSError:
                    pass
    else:
        return None
    return "sha256:" + h.hexdigest()[:16]


def audit(root: str, event: str, detail: str) -> None:
    """Append-only record of everything the pipeline decided. Never rotated by this tool."""
    try:
        p = os.path.join(root, AUDIT_LOG)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        line = "\t".join([
            time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            event,
            (head(root) or "")[:9],
            branch(root) or "-",
            os.environ.get("CLAUDE_AGENT") or os.environ.get("OPENCODE_AGENT") or "-",
            re.sub(r"\s+", " ", str(detail))[:400],
        ])
        with open(p, "a") as fh:
            fh.write(line + "\n")
    except Exception:
        pass


def receipt_write(root: str, kind: str, verdict: str, subject: str, detail: str, by: str) -> int:
    r = {
        "kind": kind,
        "verdict": verdict,
        "commit": head(root),
        "branch": branch(root),
        "subject": subject or None,
        "subjectDigest": subject_digest(root, subject),
        "detail": detail,
        "by": by,
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "treeClean": tree_clean(root),
    }
    p = receipt_path(root, kind)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as fh:
        json.dump(r, fh, indent=2)
        fh.write("\n")
    audit(root, f"receipt.{kind}", f"{verdict} by {by}: {detail}")
    print(f"{kind}: {verdict}  ->  {os.path.relpath(p, root)}")
    return 0


def receipt_problem(root: str, kind: str, verdict: str | None, max_age_min: int,
                    require_commit: bool = True) -> str | None:
    """Why this receipt does not hold, or None."""
    p = receipt_path(root, kind)
    if not os.path.exists(p):
        return f"there is no {kind} receipt"
    try:
        r = json.load(open(p))
    except Exception as e:
        return f"the {kind} receipt is unreadable ({e})"
    if verdict and r.get("verdict") != verdict:
        return f'the {kind} receipt says "{r.get("verdict")}", not "{verdict}"'
    if require_commit:
        h = head(root)
        if r.get("commit") != h:
            return (f"the {kind} receipt is for {str(r.get('commit'))[:9]} but HEAD is {h[:9]} — "
                    f"the work changed after it was granted")
    if r.get("subject") and r.get("subjectDigest"):
        now = subject_digest(root, r["subject"])
        if now and now != r["subjectDigest"]:
            return (f"the {kind} receipt is for a different version of {r['subject']} — "
                    f"it was edited after approval")
    try:
        age = (time.time() - calendar.timegm(time.strptime(r["at"], "%Y-%m-%dT%H:%M:%SZ"))) / 60
    except Exception:
        return f"the {kind} receipt has no readable timestamp"
    if age > max_age_min:
        return f"the {kind} receipt is {int(age)} minutes old (limit {max_age_min})"
    return None


# ------------------------------------------------------------------------------------- guard

DESTRUCTIVE = [
    (r"\bgit\s+stash\b(?!\s+(list|show))", "git stash hides uncommitted work; commit path-scoped instead"),
    (r"\bgit\s+reset\s+(--hard|--merge|--keep)\b", "git reset --hard destroys uncommitted work"),
    (r"\bgit\s+clean\b", "git clean deletes untracked files"),
    (r"\bgit\s+(checkout|restore)\s+(--\s+)?\.(\s|$)", "this discards every uncommitted change"),
    (r"\bgit\s+(push|branch)\b[^|;&]*--force(-with-lease)?\b", "force-push rewrites published history"),
    (r"\bgit\s+filter-(branch|repo)\b", "history rewriting is the maintainer's decision"),
    (r"\brm\s+(-[a-zA-Z]*\s+)*(-rf|-fr)\s+(/|~|\$HOME)(\s|$)", "refusing rm -rf of a root or home path"),
]
PUBLISHING = [
    (r"\bgit\s+tag\b(?!\s+(-l|--list|-n))", "a tag is a public promise — the maintainer's call"),
    (r"\bgit\s+push\b[^|;&]*(--tags|\brefs/tags/)", "pushing tags is the maintainer's call"),
    (r"\b(npm|pnpm|yarn|bun)\s+publish\b", "publishing is the maintainer's call"),
    (r"\bcargo\s+publish\b", "publishing is the maintainer's call"),
    (r"\b(twine|poetry)\s+(upload|publish)\b", "publishing is the maintainer's call"),
    (r"\bgh\s+release\s+(create|edit|delete|upload)\b", "cutting a release is the maintainer's call"),
    (r"\bdocker\s+push\b", "pushing an image is a deploy — the maintainer's call"),
]
STAGING = [
    (r"\bgit\s+add\s+(-A|--all|\.)(\s|$)", "commit path-scoped: git add <explicit paths>"),
    (r"\bgit\s+commit(\s+-{1,2}[\w-]+)*\s+(-[a-zA-Z]*a[a-zA-Z]*|--all)(\s|$)",
     "git commit -a stages the whole tree; stage explicit paths"),
]
# Commands that put a change in front of users. Detected conservatively: a false positive costs
# one approval, a false negative costs an unreviewed deployment.
DEPLOY_PATTERNS = [
    r"\b(kubectl|helm)\s+(apply|rollout|upgrade|install|delete)\b",
    r"\b(terraform|tofu)\s+(apply|destroy)\b",
    r"\b(serverless|sls)\s+deploy\b",
    r"\baws\s+(deploy|ecs|lambda|cloudformation|s3\s+sync)\b",
    r"\b(gcloud|az)\s+\w+\s+deploy\b",
    r"\b(flyctl|fly|vercel|netlify|heroku|railway|render)\s+(deploy|releases?)\b",
    r"\bdocker\s+(compose\s+)?(up|stack\s+deploy)\b[^|;&]*(prod|production)",
    r"\bansible-playbook\b",
    r"\bgh\s+workflow\s+run\b[^|;&]*(deploy|release|prod)",
]

CREDENTIALS = [
    (r"(^|[\s;|&(])(cat|bat|less|more|head|tail|strings|xxd|od|cp|scp|rsync|curl)\b[^|;&]*"
     r"(\.env(\.(?!example|sample|template)[\w.-]+)?|/\.ssh/|/\.aws/|id_rsa|id_ed25519|\.pem|\.p12|"
     r"credentials\.json|secrets\.ya?ml)(\s|$|['\")])",
     "reading a credential file is forbidden"),
    (r"\b(sk-[A-Za-z0-9]{12,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{12,})",
     "a credential appears in this command line"),
]


def guard_problem(root: str, command: str, cfg: dict) -> str | None:
    enforce = cfg.get("enforce") or {}
    groups = []
    if enforce.get("blockDestructiveGit", True):
        groups += DESTRUCTIVE + STAGING
    if enforce.get("blockPublishing", True):
        groups += PUBLISHING
    if enforce.get("blockCredentialReads", True):
        groups += CREDENTIALS
    for pattern, why in groups:
        if re.search(pattern, command):
            return f"{why}."

    protected = cfg.get("protected") or ["main", "master"]
    trunk = cfg.get("trunk") or "main"
    prot_re = "|".join(re.escape(p).replace(r"\*", r"[^\s]*") for p in set(protected + [trunk]))
    max_age = int(((cfg.get("receipts") or {}).get("maxAgeMin")) or DEFAULT_MAX_AGE_MIN)
    approvals = cfg.get("approvals") or {}
    cur = branch(root)

    if enforce.get("pushToTrunkNeedsGate", True) and re.search(r"\bgit\s+push\b", command):
        named = re.search(r"\bgit\s+push\b\s+\S+\s+\S", command)
        targets_protected = bool(re.search(rf"\b({prot_re})\b", command)) or (
            not named and re.fullmatch(rf"({prot_re})", cur or "") is not None)
        if targets_protected:
            why = receipt_problem(root, "gate", "passed", max_age)
            if why:
                return (f"pushing a protected branch needs a passed gate receipt, and {why}.\n"
                        f"Run `/agentic-sdlc:gate` (the mechanical checks and the secret scan), or "
                        f"push a feature branch and open a pull request instead — that needs no "
                        f"receipt.")

    if enforce.get("mergeNeedsReadiness", True):
        merging = re.search(r"\bgh\s+pr\s+merge\b", command) or (
            re.search(r"\bgit\s+merge\b", command)
            and not re.search(r"--(abort|continue|quit)\b", command)
            and re.fullmatch(rf"({prot_re})", cur or "") is not None)
        if merging:
            why = receipt_problem(root, "readiness", "ready", max_age)
            if why:
                return (f"merging needs a READY readiness receipt, and {why}.\n"
                        f"Run `/agentic-sdlc:readiness`. It runs the reviewers, the secret scan and "
                        f"the verify command, and checks every acceptance criterion against evidence.")
            if approvals.get("merge") == "human":
                why = receipt_problem(root, "approval_merge", "granted", max_age)
                if why:
                    return (f"this project requires a human to approve a merge, and {why}.\n"
                            f"A person runs:  sdlc approve merge --as '<their name>'\n"
                            f"An agent must not run it for them — the approval records who is "
                            f"accountable, and an agent approving its own work records nothing.")

    # Deployment is a separate authority from merging, and defaults to a human's.
    deploying = any(re.search(pat, command) for pat in DEPLOY_PATTERNS)
    if deploying:
        if approvals.get("release", "human") == "human":
            why = receipt_problem(root, "approval_release", "granted", max_age)
            if why:
                return (f"deploying needs a human approval, and {why}.\n"
                        f"A person runs:  sdlc approve release --as '<their name>'\n"
                        f"Deployment changes what users are running. No agent grants itself that.")
        why = receipt_problem(root, "readiness", "ready", max_age)
        if why:
            return f"deploying needs a READY readiness receipt, and {why}."
    return None


def cmd_guard(args) -> int:
    """The refusal point. Reads a host's tool JSON on stdin, or one command with --command.

    The same rules serve every host: Claude Code, Codex and Cline send the same wire shape,
    opencode's plugin reshapes into it, and the git hooks pass --command.
    """
    if getattr(args, "command", None):
        root = repo_root()
        problem = guard_problem(root, args.command, load_config(root))
        if problem:
            audit(root, "blocked", f"{problem.splitlines()[0]} :: {args.command}")
            print(f"BLOCKED by agentic-sdlc: {problem}", file=sys.stderr)
            return 2
        return 0
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0  # never break a session over a malformed payload
    tool = payload.get("tool_name") or payload.get("tool") or ""
    inp = payload.get("tool_input") or payload.get("input") or {}
    cwd = payload.get("cwd") or os.getcwd()
    root = repo_root(cwd)
    cfg = load_config(root)

    if tool in ("Bash", "bash", "shell"):
        command = str(inp.get("command", ""))
        if not command:
            return 0
        problem = guard_problem(root, command, cfg)
        if problem:
            audit(root, "blocked", f"{problem.splitlines()[0]} :: {command}")
            print(f"BLOCKED by agentic-sdlc: {problem}\n"
                  f"This is a pipeline rule, not a preference. Do not work around it — choose "
                  f"another route or stop and report.", file=sys.stderr)
            return 2
    elif tool in ("Edit", "Write", "NotebookEdit", "edit", "write"):
        path = str(inp.get("file_path") or inp.get("path") or "")
        if re.search(r"(^|/)(\.env(\.(?!example|sample|template)[\w.-]+)?|credentials\.json|"
                     r"secrets\.ya?ml|id_rsa|id_ed25519|.*\.pem)$|(^|/)\.(ssh|aws)/", path):
            print(f"BLOCKED by agentic-sdlc: {path} holds credentials.", file=sys.stderr)
            return 2
    return 0


# ------------------------------------------------------------------------------- subcommands


def cmd_init(args) -> int:
    root = repo_root()
    cfg = detect(root)
    existing = load_config(root)
    if existing:
        # Keep what a human has set; only fill what detection newly knows.
        for k, v in existing.items():
            if k != "$schema":
                cfg[k] = v
        cfg.setdefault("version", 2)
    out = json.dumps(cfg, indent=2) + "\n"
    target = os.path.join(root, "sdlc.config.json")
    if not args.write:
        print(out, end="")
        print(f"\n# not written — re-run with --write to save {os.path.relpath(target, root)}",
              file=sys.stderr)
        return 0
    open(target, "w").write(out)
    print(f"wrote {os.path.relpath(target, root)}")
    if cfg["spec"]["engine"] == "openspec" and not os.path.isdir(os.path.join(root, "openspec")):
        print("openspec is available but this repo has no openspec/ — run: openspec init")
    if not cfg.get("verifyCmd"):
        print("no verify command could be detected — set \"verifyCmd\" by hand; the pipeline "
              "cannot gate anything without it")
    return 0


def cmd_config(_args) -> int:
    root = repo_root()
    p = config_path(root)
    if not p:
        print("no sdlc.config.json — run: sdlc init --write", file=sys.stderr)
        return 1
    print(f"# {os.path.relpath(p, root)}")
    print(json.dumps(load_config(root), indent=2))
    return 0


def cmd_receipt(args) -> int:
    root = repo_root()
    if args.receipt_action == "write":
        if not args.verdict:
            print("sdlc receipt write needs --verdict", file=sys.stderr)
            return 3
        return receipt_write(root, args.kind, args.verdict, args.subject, args.detail, args.by)
    if args.receipt_action == "show":
        p = receipt_path(root, args.kind)
        if not os.path.exists(p):
            print(f"no {args.kind} receipt", file=sys.stderr)
            return 1
        print(open(p).read(), end="")
        return 0
    cfg = load_config(root)
    max_age = args.max_age_min or int(((cfg.get("receipts") or {}).get("maxAgeMin")) or DEFAULT_MAX_AGE_MIN)
    why = receipt_problem(root, args.kind, args.verdict, max_age, require_commit=not args.any_commit)
    if why:
        print(f"{args.kind} receipt does not hold: {why}", file=sys.stderr)
        return 1
    print(f"{args.kind} receipt holds")
    return 0


def cmd_status(_args) -> int:
    root = repo_root()
    cfg = load_config(root)
    print(f"repo      {os.path.basename(root)}")
    print(f"branch    {branch(root)}   (trunk: {cfg.get('trunk', '?')})")
    print(f"head      {head(root)[:9]}  tree {'clean' if tree_clean(root) else 'DIRTY'}")
    spec = cfg.get("spec") or {}
    print(f"spec      engine {spec.get('engine', '?')}, root {spec.get('docsRoot', '?')}")
    print(f"verify    {cfg.get('verifyCmd') or '(none set — the gate cannot run)'}")
    if cfg.get("gateCmd"):
        print(f"gate      {cfg['gateCmd']}")
    print("receipts")
    for kind in RECEIPT_KINDS:
        p = receipt_path(root, kind)
        if not os.path.exists(p):
            continue
        try:
            r = json.load(open(p))
        except Exception:
            continue
        why = receipt_problem(root, kind, None, 10 ** 9)
        mark = "stale" if why else "current"
        print(f"  {kind:<13} {r.get('verdict','?'):<18} {str(r.get('commit',''))[:9]}  {r.get('at','')}  {mark}")
    return 0


def cmd_doctor(_args) -> int:
    root = repo_root()
    cfg = load_config(root)
    problems, notes = [], []

    if not git("rev-parse", "--is-inside-work-tree", cwd=root):
        problems.append("not inside a git repository — the pipeline needs git")
    if not cfg:
        problems.append("no sdlc.config.json — run: sdlc init --write")
    else:
        if not cfg.get("verifyCmd"):
            problems.append('"verifyCmd" is not set — nothing can be gated')
        if not cfg.get("secretScan"):
            notes.append('"secretScan" is not set — install gitleaks and re-run `sdlc init`')
        engine = (cfg.get("spec") or {}).get("engine")
        if engine == "openspec":
            if not which("openspec"):
                problems.append('spec.engine is "openspec" but the openspec CLI is not installed')
            elif not os.path.isdir(os.path.join(root, "openspec")):
                problems.append("openspec is configured but this repo has no openspec/ — run: openspec init")
        if cfg.get("trunk") and cfg["trunk"] != detect_trunk(root):
            notes.append(f'config says trunk "{cfg["trunk"]}" but git says "{detect_trunk(root)}"')

    present = detect_platforms()
    here = [k for k, v in present.items() if v]
    print(f"hosts detected  {', '.join(here) if here else 'none'}")
    installed = []
    for rel, label in ((".cursor/rules/agentic-sdlc.mdc", "cursor"),
                       (".github/copilot-instructions.md", "copilot"),
                       (".clinerules/agentic-sdlc.md", "cline"),
                       (".roo/rules/agentic-sdlc.md", "roo"),
                       (".kilocode/rules/agentic-sdlc.md", "kilo"),
                       (".windsurf/rules/agentic-sdlc.md", "windsurf"),
                       (".continue/rules/agentic-sdlc.md", "continue"),
                       (".gemini/policies/agentic-sdlc.toml", "gemini"),
                       ("AGENTS.md", "agents.md"),
                       (".github/workflows/sdlc-gate.yml", "ci")):
        if os.path.exists(os.path.join(root, rel)):
            installed.append(label)
    hooks_dir = git("rev-parse", "--git-path", "hooks", cwd=root) or ".git/hooks"
    if not os.path.isabs(hooks_dir):
        hooks_dir = os.path.join(root, hooks_dir)
    hooked = [n for n in ("pre-commit", "pre-push")
              if os.path.exists(os.path.join(hooks_dir, n))
              and "agentic-sdlc" in open(os.path.join(hooks_dir, n), errors="replace").read()]
    if hooked:
        installed.append("git-hooks(" + ",".join(hooked) + ")")
    print(f"installed here  {', '.join(installed) if installed else 'nothing yet — run: sdlc install'}")
    missing = [h for h in here if h in TARGETS and TARGETS[h][0] and h not in " ".join(installed)]
    if missing:
        notes.append(f"detected but not installed: {', '.join(missing)} — run `sdlc install "
                     f"{' '.join(missing)}`")
    if not hooked:
        notes.append("no git hooks — they are the only local enforcement on hosts without a "
                     "tool hook (Cursor, Copilot, Windsurf). Run `sdlc install git-hooks`")
    if not os.path.exists(os.path.join(root, ".github/workflows/sdlc-gate.yml")):
        notes.append("no CI gate — the only layer an agent cannot reach. Run `sdlc install ci`")

    hooks = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "hooks", "hooks.json")
    if os.path.exists(hooks):
        notes.append(f"hooks shipped at {hooks} — enforcement is active when the plugin is installed")
    else:
        problems.append("hooks/hooks.json is missing — the pipeline would be advisory only")

    for name, why in (("git", "required"), ("gh", "pull requests"), ("gitleaks", "secret scanning"),
                      ("openspec", "the OpenSpec engine")):
        if not which(name):
            (problems if why == "required" else notes).append(f"{name} not found ({why})")

    for n in notes:
        print(f"note     {n}")
    for p in problems:
        print(f"PROBLEM  {p}")
    print("doctor: ok" if not problems else f"doctor: {len(problems)} problem(s)")
    return 0 if not problems else 1




# ============================================================================== install
#
# One pipeline, many hosts. The canonical sources are agents/, commands/ and docs/rules.md;
# every adapter below is a pure mapping from those into one platform's layout. Nothing is
# authored twice, so nothing can drift.
#
# Three enforcement layers, because platforms differ in what they allow:
#   1. a native tool hook  — Claude Code, Codex, Cline, opencode: refuses before the action
#   2. git hooks           — everywhere, because every agent shells out to git
#   3. CI                  — the only layer an agent cannot reach at all
# What a platform cannot do is written down in docs/platforms.md rather than implied away.

BEGIN = "BEGIN agentic-sdlc (generated — edit docs/rules.md or sdlc.config.json, then re-run)"
END = "END agentic-sdlc"


def plugin_root() -> str:
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def read_plugin(*parts: str) -> str:
    try:
        return open(os.path.join(plugin_root(), *parts), errors="replace").read()
    except OSError:
        return ""


class Writer:
    """Collects writes so --dry-run can show them and nothing is half-applied."""

    def __init__(self, dry: bool):
        self.dry, self.written, self.skipped = dry, [], []
        self.pending = {}   # several adapters write AGENTS.md; it is one file, not five

    def put(self, path: str, content: str, mode: int = 0o644) -> None:
        if path in self.pending:
            self.skipped.append(path)
            return
        try:
            old = open(path, errors="replace").read()
        except OSError:
            old = None
        self.pending[path] = content
        if old == content:
            self.skipped.append(path)
            return
        self.written.append(path)
        if self.dry:
            return
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w") as fh:
            fh.write(content)
        os.chmod(path, mode)

    def block(self, path: str, body: str, comment: str = "<!-- {} -->") -> None:
        """Write our section into a file we do not own, leaving everything else alone."""
        begin, end = comment.format(BEGIN), comment.format(END)
        section = f"{begin}\n{body.strip()}\n{end}\n"
        if path in self.pending:
            old = self.pending[path]
        else:
            try:
                old = open(path, errors="replace").read()
            except OSError:
                old = ""
        if begin in old and end in old:
            head, _, rest = old.partition(begin)
            _, _, tail = rest.partition(end)
            new = head + section + tail.lstrip("\n")
        elif old.strip():
            new = old.rstrip("\n") + "\n\n" + section
        else:
            new = section
        self.put(path, new)

    def report(self) -> None:
        verb = "would write" if self.dry else "wrote"
        for p in self.written:
            print(f"  {verb} {p}")
        if self.skipped:
            print(f"  ({len(self.skipped)} already current)")


def detect_platforms() -> dict:
    """Which hosts are present. A binary on PATH or a config directory both count."""
    home = os.path.expanduser("~")
    checks = {
        "claude-code": which("claude") or os.path.isdir(f"{home}/.claude"),
        "opencode": which("opencode") or os.path.isdir(f"{home}/.config/opencode"),
        "codex": which("codex") or os.path.isdir(f"{home}/.codex"),
        "gemini": which("gemini") or os.path.isdir(f"{home}/.gemini"),
        "cursor": which("cursor-agent") or which("cursor") or os.path.isdir(f"{home}/.cursor"),
        "copilot": os.path.isdir(f"{home}/.vscode") or which("code"),
        "cline": bool(glob.glob(f"{home}/.vscode/extensions/saoudrizwan.claude-dev-*")),
        "roo": bool(glob.glob(f"{home}/.vscode/extensions/rooveterinaryinc.roo-cline-*")),
        "kilo": bool(glob.glob(f"{home}/.vscode/extensions/kilocode.kilo-code-*")),
        "windsurf": os.path.isdir("/Applications/Windsurf.app") or os.path.isdir(f"{home}/.codeium"),
        "continue": os.path.isdir(f"{home}/.continue"),
        "aider": which("aider"),
        "zed": which("zed") or os.path.isdir(f"{home}/.config/zed"),
        "amp": which("amp"),
        "warp": os.path.isdir("/Applications/Warp.app"),
        "factory": which("droid"),
    }
    return {k: bool(v) for k, v in checks.items()}


def interpreter() -> str:
    """The command that will run this CLI from a hook. Windows often lacks `python3`."""
    for cand in ("python3", "python"):
        if which(cand):
            return cand
    return sys.executable or "python3"


def cli_path() -> str:
    return os.path.join(plugin_root(), "bin", "sdlc")


def guard_command() -> str:
    return f'{interpreter()} "{cli_path()}" guard'



# ---------------------------------------------------------------- what each platform is told

def rules_body(cfg: dict) -> str:
    """The pipeline's rules, plus this project's bindings. One source: docs/rules.md."""
    rules = read_plugin("docs", "rules.md")
    rules = re.sub(r"^# .*\n+", "", rules, count=1)  # the host file supplies the title
    lines = ["## The agentic SDLC pipeline", "",
             "This project uses the agentic-sdlc pipeline. Work moves through stages, each owned",
             "by one agent and closed by a receipt bound to a commit. Do not skip a stage: on some",
             "hosts the skip is refused outright, and on all of them a git hook and CI will catch",
             "it later, more expensively.", ""]
    if cfg:
        lines += ["### This project", "",
                  f"- trunk: `{cfg.get('trunk', 'main')}`",
                  f"- verify: `{cfg.get('verifyCmd') or '(not set — set verifyCmd in sdlc.config.json)'}`"]
        if cfg.get("gateCmd"):
            lines.append(f"- gate: `{cfg['gateCmd']}`")
        spec = cfg.get("spec") or {}
        lines.append(f"- specifications: {spec.get('engine', 'prd-frd')} in `{spec.get('docsRoot', 'docs/specs')}`")
        if cfg.get("profile"):
            lines.append(f"- profile: `{cfg['profile']}` — its standards apply to reviews")
        if cfg.get("heavy"):
            lines.append(f"- heavy work: {cfg['heavy']}")
        lines.append("")
    lines += ["### Commands", "",
              "```sh",
              "sdlc status            # which stages have left evidence, which have not",
              "sdlc trace             # requirement -> commit -> test -> receipts",
              "sdlc receipt check readiness --verdict ready",
              "sdlc feedback read     # why the last attempt failed, before you retry",
              "```", ""]
    return "\n".join(lines) + "\n" + rules.strip() + "\n"


def stage_prompts() -> list:
    """(name, description, body) for each pipeline stage, from commands/."""
    out = []
    for f in sorted(glob.glob(os.path.join(plugin_root(), "commands", "*.md"))):
        text = open(f, errors="replace").read()
        m = re.match(r"^---\n([\s\S]*?)\n---\n?", text)
        fm, body = (m.group(1), text[m.end():]) if m else ("", text)
        desc = ""
        d = re.search(r"^description:\s*(.+)$", fm, re.M)
        if d:
            desc = d.group(1).strip()
        # Shell injections and plugin-root paths mean nothing outside Claude Code.
        body = re.sub(r"^!`.*`\s*$", "", body, flags=re.M)
        body = body.replace("${CLAUDE_PLUGIN_ROOT}/bin/sdlc", "sdlc")
        body = re.sub(r"\n{3,}", "\n\n", body).strip()
        out.append((os.path.basename(f)[:-3], desc, body))
    return out


def agent_summary() -> str:
    """Who owns what — so a host without subagents still knows the division of labour."""
    rows = []
    for f in sorted(glob.glob(os.path.join(plugin_root(), "agents", "*.md"))):
        text = open(f, errors="replace").read()
        m = re.search(r"^description:\s*>?\s*\n?([\s\S]*?)(?=^\w+:|^---)", text, re.M)
        desc = re.sub(r"\s+", " ", m.group(1)).strip() if m else ""
        rows.append(f"- **{os.path.basename(f)[:-3]}** — {desc[:160]}")
    return "\n".join(rows)



# ------------------------------------------------------------------------------- adapters
#
# Each adapter takes (root, cfg, w: Writer) and writes that platform's files. Every path is
# verified against the real tool on 2026-10-25 — see docs/platforms.md for the evidence.

def _agents_md(root: str, cfg: dict, w: Writer, name: str = "AGENTS.md") -> None:
    """The universal layer: agents.md is read by 20+ hosts, so this is most tools' whole story."""
    w.block(os.path.join(root, name), rules_body(cfg))


def _rules_file(root: str, cfg: dict, w: Writer, relpath: str) -> None:
    w.block(os.path.join(root, relpath), rules_body(cfg))


def _prompt_files(root: str, w: Writer, directory: str, suffix: str = ".md",
                  prefix: str = "sdlc-", frontmatter=None) -> None:
    for name, desc, body in stage_prompts():
        head = frontmatter(name, desc) if frontmatter else ""
        w.put(os.path.join(root, directory, f"{prefix}{name}{suffix}"), head + body + "\n")


def adapt_opencode(root: str, cfg: dict, w: Writer) -> None:
    """opencode: agents with real permissions, commands, and a plugin that calls the guard."""
    prefix = os.path.expanduser("~/.config/opencode")
    for f in sorted(glob.glob(os.path.join(plugin_root(), "agents", "*.md"))):
        text = open(f, errors="replace").read().replace("${CLAUDE_PLUGIN_ROOT}", plugin_root())
        m = re.match(r"^---\n([\s\S]*?)\n---", text)
        if m:
            fm = m.group(1)
            tools = re.search(r"^tools:\s*\[(.*?)\]\s*$", fm, re.M)
            edits = True
            if tools:
                listed = [t.strip() for t in tools.group(1).split(",")]
                edits = any(t in ("Write", "Edit", "NotebookEdit") for t in listed)
                fm = re.sub(r"^tools:.*$\n?", "", fm, flags=re.M)
            mode = "primary" if re.search(r"(implementer|spec-writer)", f) else "subagent"
            text = (f"---\n{fm.rstrip()}\nmode: {mode}\ntemperature: 0.1\n"
                    f"permission:\n  edit: {'allow' if edits else 'deny'}\n  bash: allow\n---"
                    + text[m.end():])
        w.put(os.path.join(prefix, "agents", os.path.basename(f)), text)
    for f in sorted(glob.glob(os.path.join(plugin_root(), "commands", "*.md"))):
        text = open(f, errors="replace").read().replace("${CLAUDE_PLUGIN_ROOT}", plugin_root())
        w.put(os.path.join(prefix, "commands", "sdlc-" + os.path.basename(f)), text)
    tpl = read_plugin("opencode", "plugin", "agentic-sdlc.ts")
    w.put(os.path.join(prefix, "plugins", "agentic-sdlc.ts"),
          tpl.replace("__PLUGIN_ROOT__", plugin_root()))
    _agents_md(root, cfg, w)


def adapt_codex(root: str, cfg: dict, w: Writer) -> None:
    """Codex CLI: PreToolUse hooks with the same wire contract as Claude Code."""
    hooks_path = os.path.expanduser("~/.codex/hooks.json")
    try:
        existing = json.load(open(hooks_path))
    except Exception:
        existing = {}
    hooks = existing.setdefault("hooks", {})
    entries = [e for e in hooks.get("PreToolUse", [])
               if not any("sdlc" in (h.get("command") or "") for h in e.get("hooks", []))]
    entries.append({"hooks": [{"type": "command", "command": guard_command(), "timeout": 10}]})
    hooks["PreToolUse"] = entries          # every other event the user configured is untouched
    w.put(hooks_path, json.dumps(existing, indent=2) + "\n")
    _prompt_files(os.path.expanduser("~/.codex"), w, "prompts")
    _agents_md(root, cfg, w)


def adapt_gemini(root: str, cfg: dict, w: Writer) -> None:
    """Gemini CLI: no PreToolUse, but a policy engine that denies static patterns."""
    lines = ["# agentic-sdlc — generated. Gemini has no pre-tool hook, so only the static",
             "# refusals live here; the receipt-dependent gates are enforced by the git hooks.",
             "# Re-run `sdlc install gemini` to regenerate.", ""]
    groups = [("destructive", DESTRUCTIVE), ("publishing", PUBLISHING), ("staging", STAGING),
              ("credentials", CREDENTIALS)]
    pri = 100
    for label, rules in groups:
        for pattern, why in rules:
            lines += ["[[rules]]", 'toolName = "run_shell_command"',
                      f"argsPattern = {json.dumps(pattern)}", 'decision = "deny"',
                      f"priority = {pri}", f"# {label}: {why}", ""]
            pri += 1
    w.put(os.path.join(root, ".gemini", "policies", "agentic-sdlc.toml"), "\n".join(lines))
    for name, desc, body in stage_prompts():
        toml = (f'# agentic-sdlc — generated\ndescription = {json.dumps(desc or name)}\n'
                f'prompt = """\n{body}\n"""\n')
        w.put(os.path.join(root, ".gemini", "commands", "sdlc", f"{name}.toml"), toml)
    _agents_md(root, cfg, w)
    _agents_md(root, cfg, w, "GEMINI.md")


def adapt_cline(root: str, cfg: dict, w: Writer) -> None:
    """Cline: .clinerules, plus PreToolUse hooks as executables named for the event."""
    _rules_file(root, cfg, w, os.path.join(".clinerules", "agentic-sdlc.md"))
    hook = ("#!/bin/sh\n"
            "# agentic-sdlc — refuses a tool call that would skip a pipeline stage.\n"
            "# Cline runs this with the hook payload on stdin; exit 2 blocks the call.\n"
            f'exec {interpreter()} "{cli_path()}" guard\n')
    w.put(os.path.join(root, ".clinerules", "hooks", "PreToolUse"), hook, mode=0o755)
    for name, desc, body in stage_prompts():
        w.put(os.path.join(root, ".clinerules", "workflows", f"sdlc-{name}.md"),
              f"# {desc or name}\n\n{body}\n")
    _agents_md(root, cfg, w)


def adapt_cursor(root: str, cfg: dict, w: Writer) -> None:
    """Cursor: .cursor/rules/*.mdc with alwaysApply, and .cursor/commands/*.md."""
    body = ("---\n"
            "description: The agentic-sdlc pipeline — stages, receipts and what is refused\n"
            "alwaysApply: true\n"
            "---\n\n" + rules_body(cfg))
    w.put(os.path.join(root, ".cursor", "rules", "agentic-sdlc.mdc"), body)
    if cfg.get("profile"):
        prof = read_plugin("profiles", f"{cfg['profile']}.md")
        if prof:
            w.put(os.path.join(root, ".cursor", "rules", f"agentic-sdlc-{cfg['profile']}.mdc"),
                  f"---\ndescription: Standards for a {cfg['profile']} project\n"
                  f"alwaysApply: true\n---\n\n{prof}")
    _prompt_files(root, w, os.path.join(".cursor", "commands"))
    _agents_md(root, cfg, w)


def adapt_copilot(root: str, cfg: dict, w: Writer) -> None:
    """GitHub Copilot: repository instructions plus prompt files."""
    _rules_file(root, cfg, w, os.path.join(".github", "copilot-instructions.md"))
    def fm(name, desc):
        return f"---\nmode: agent\ndescription: {desc or name}\n---\n\n"
    _prompt_files(root, w, os.path.join(".github", "prompts"), suffix=".prompt.md",
                  frontmatter=fm)
    _agents_md(root, cfg, w)


def adapt_roo(root: str, cfg: dict, w: Writer) -> None:
    _rules_file(root, cfg, w, os.path.join(".roo", "rules", "agentic-sdlc.md"))
    _agents_md(root, cfg, w)


def adapt_kilo(root: str, cfg: dict, w: Writer) -> None:
    _rules_file(root, cfg, w, os.path.join(".kilocode", "rules", "agentic-sdlc.md"))
    _agents_md(root, cfg, w)


def adapt_windsurf(root: str, cfg: dict, w: Writer) -> None:
    _rules_file(root, cfg, w, os.path.join(".windsurf", "rules", "agentic-sdlc.md"))
    for name, desc, body in stage_prompts():
        w.put(os.path.join(root, ".windsurf", "workflows", f"sdlc-{name}.md"),
              f"---\ndescription: {desc or name}\n---\n\n{body}\n")
    _agents_md(root, cfg, w)


def adapt_continue(root: str, cfg: dict, w: Writer) -> None:
    _rules_file(root, cfg, w, os.path.join(".continue", "rules", "agentic-sdlc.md"))
    _agents_md(root, cfg, w)


def adapt_aider(root: str, cfg: dict, w: Writer) -> None:
    _rules_file(root, cfg, w, "CONVENTIONS.md")
    _agents_md(root, cfg, w)


def adapt_generic(root: str, cfg: dict, w: Writer) -> None:
    """Zed, Amp, Warp, Junie, Factory, Devin, Jules and anything else that reads AGENTS.md."""
    _agents_md(root, cfg, w)



def adapt_git_hooks(root: str, cfg: dict, w: Writer) -> None:
    """The only local enforcement every platform shares: every agent shells out to git.

    An existing hook is never destroyed — our part goes in a guarded block, so a repo that
    already uses husky or pre-commit keeps working.
    """
    hooks_dir = git("rev-parse", "--git-path", "hooks", cwd=root) or ".git/hooks"
    if not os.path.isabs(hooks_dir):
        hooks_dir = os.path.join(root, hooks_dir)
    marker_begin = "# >>> agentic-sdlc >>>"
    marker_end = "# <<< agentic-sdlc <<<"

    bodies = {
        "pre-commit": (
            f'{marker_begin}\n'
            f'# Staging hygiene and a secret scan on what is actually staged.\n'
            f'staged=$(git diff --cached --name-only)\n'
            f'[ -z "$staged" ] || {interpreter()} "{cli_path()}" guard --command '
            f'"git commit" || exit 2\n'
            f'{marker_end}\n'),
        "pre-push": (
            f'{marker_begin}\n'
            f'# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin.\n'
            f'while read -r _ _ remote_ref _; do\n'
            f'  [ -n "$remote_ref" ] || continue\n'
            f'  {interpreter()} "{cli_path()}" guard --command "git push origin ${{remote_ref##*/}}" '
            f'|| exit 2\n'
            f'done\n'
            f'{marker_end}\n'),
    }

    for name, block in bodies.items():
        path = os.path.join(hooks_dir, name)
        try:
            old = open(path, errors="replace").read()
        except OSError:
            old = ""
        if marker_begin in old and marker_end in old:
            head, _, rest = old.partition(marker_begin)
            _, _, tail = rest.partition(marker_end)
            new = head + block.rstrip("\n") + tail
        elif old.strip():
            new = old.rstrip("\n") + "\n\n" + block      # keep whatever was already there
        else:
            new = "#!/bin/sh\n" + block
        w.put(path, new, mode=0o755)


def adapt_ci(root: str, cfg: dict, w: Writer) -> None:
    """The layer an agent cannot reach. It re-runs the checks rather than trusting receipts."""
    verify = cfg.get("gateCmd") or cfg.get("verifyCmd") or "echo 'set verifyCmd in sdlc.config.json' && false"
    secret = cfg.get("secretScan") or ""
    quality = (cfg.get("quality") or {}).get("cmd") or ""
    y = ["# agentic-sdlc — generated by `sdlc install ci`. The authoritative gate: it runs",
         "# where no agent can reach it, and it re-runs the checks rather than trusting a",
         "# receipt, because receipts are local to a working copy by design.",
         "name: SDLC gate", "",
         "on:", "  pull_request:", "  workflow_dispatch:", "",
         "permissions:", "  contents: read", "",
         "jobs:", "  gate:", "    runs-on: ubuntu-latest", "    steps:",
         "      - uses: actions/checkout@v6", "        with:", "          fetch-depth: 0",
         "      - name: Verify", f"        run: {verify}"]
    if secret:
        y += ["      - name: Secret scan", f"        run: {secret}"]
    if quality:
        y += ["      - name: Quality budget on new code", f"        run: {quality}"]
    y += ["      - name: Traceability",
          "        run: |",
          '          python3 "$GITHUB_WORKSPACE/bin/sdlc" trace >> "$GITHUB_STEP_SUMMARY" 2>/dev/null \\',
          '            || echo "sdlc not vendored in this repo; skipping the trace summary" >> "$GITHUB_STEP_SUMMARY"']
    w.put(os.path.join(root, ".github", "workflows", "sdlc-gate.yml"), "\n".join(y) + "\n")


TARGETS = {
    "claude-code": (None, "the plugin itself — install it with /plugin install"),
    "opencode": (adapt_opencode, "agents, commands and a plugin that calls the guard"),
    "codex": (adapt_codex, "PreToolUse hook, prompts, AGENTS.md"),
    "gemini": (adapt_gemini, "policy denies, TOML commands, GEMINI.md"),
    "cline": (adapt_cline, "rules, PreToolUse hook, workflows"),
    "cursor": (adapt_cursor, "always-on .mdc rules and commands"),
    "copilot": (adapt_copilot, "repository instructions and prompt files"),
    "roo": (adapt_roo, ".roo/rules"),
    "kilo": (adapt_kilo, ".kilocode/rules"),
    "windsurf": (adapt_windsurf, "rules and workflows"),
    "continue": (adapt_continue, ".continue/rules"),
    "aider": (adapt_aider, "CONVENTIONS.md and AGENTS.md"),
    "generic": (adapt_generic, "AGENTS.md — Zed, Amp, Warp, Junie, Factory, Devin, Jules"),
    "git-hooks": (adapt_git_hooks, "pre-commit and pre-push — the universal local floor"),
    "ci": (adapt_ci, "a GitHub Actions gate that no agent can reach"),
}

# What each host can actually do. Stated here so --list cannot drift from the documentation.
ENFORCEMENT = {
    "claude-code": "refuses the tool call", "opencode": "refuses the tool call",
    "codex": "refuses the tool call", "cline": "refuses the tool call",
    "gemini": "static policy denies only", "git-hooks": "refuses the git command",
    "ci": "fails the pull request",
}


def cmd_install(args) -> int:
    root = repo_root()
    cfg = load_config(root)
    present = detect_platforms()

    if args.list:
        print("target        enforcement                  what it writes")
        for name, (fn, what) in TARGETS.items():
            mark = "·" if not present.get(name, name in ("generic", "git-hooks", "ci")) else "✓"
            print(f"{mark} {name:<12} {ENFORCEMENT.get(name, 'instructions only'):<28} {what}")
        print("\n✓ = detected on this machine. Enforcement differs by host — see docs/platforms.md.")
        return 0

    targets = list(args.targets)
    if not targets:
        targets = [k for k, v in present.items() if v and k in TARGETS and TARGETS[k][0]]
        if not targets:
            targets = ["generic"]
        print(f"detected: {', '.join(targets)}")
    unknown = [t for t in targets if t not in TARGETS]
    if unknown:
        print(f"unknown target(s): {', '.join(unknown)}. Try `sdlc install --list`.", file=sys.stderr)
        return 3
    if not args.no_git_hooks and "git-hooks" not in targets:
        targets.append("git-hooks")

    w = Writer(args.dry_run)
    for t in targets:
        fn = TARGETS[t][0]
        if fn is None:
            print(f"{t}: nothing to install — {TARGETS[t][1]}")
            continue
        print(f"{t}:")
        fn(root, cfg, w)
    w.report()
    if not args.dry_run:
        audit(root, "install", ", ".join(targets))
    if args.dry_run:
        print("\nnothing was written — drop --dry-run to apply")
    else:
        print("\nNext: `sdlc doctor`, then read docs/platforms.md for what each host can "
              "actually enforce.")
    return 0


def cmd_uninstall(args) -> int:
    """Remove only our marker blocks and only files we own. Never a whole file we share."""
    root = repo_root()
    removed = []
    owned = [".cursor/rules/agentic-sdlc.mdc", ".gemini/policies/agentic-sdlc.toml",
             ".clinerules/hooks/PreToolUse", ".github/workflows/sdlc-gate.yml"]
    for rel in owned:
        p = os.path.join(root, rel)
        if os.path.exists(p):
            removed.append(rel)
            if not args.dry_run:
                os.remove(p)
    for pattern in (".cursor/commands/sdlc-*", ".github/prompts/sdlc-*", ".gemini/commands/sdlc/*",
                    ".clinerules/workflows/sdlc-*", ".windsurf/workflows/sdlc-*"):
        for p in glob.glob(os.path.join(root, pattern)):
            removed.append(os.path.relpath(p, root))
            if not args.dry_run:
                os.remove(p)
    shared = ["AGENTS.md", "GEMINI.md", "CONVENTIONS.md", ".github/copilot-instructions.md",
              ".clinerules/agentic-sdlc.md", ".roo/rules/agentic-sdlc.md",
              ".kilocode/rules/agentic-sdlc.md", ".windsurf/rules/agentic-sdlc.md",
              ".continue/rules/agentic-sdlc.md"]
    for rel in shared:
        p = os.path.join(root, rel)
        if not os.path.exists(p):
            continue
        text = open(p, errors="replace").read()
        if BEGIN not in text:
            continue
        head, _, rest = text.partition(f"<!-- {BEGIN} -->")
        _, _, tail = rest.partition(f"<!-- {END} -->")
        new = (head.rstrip() + "\n" + tail.lstrip("\n")).strip()
        removed.append(f"{rel} (our block)")
        if not args.dry_run:
            if new:
                open(p, "w").write(new + "\n")
            else:
                os.remove(p)
    hooks_dir = git("rev-parse", "--git-path", "hooks", cwd=root) or ".git/hooks"
    if not os.path.isabs(hooks_dir):
        hooks_dir = os.path.join(root, hooks_dir)
    for name in ("pre-commit", "pre-push"):
        p = os.path.join(hooks_dir, name)
        if not os.path.exists(p):
            continue
        text = open(p, errors="replace").read()
        if "# >>> agentic-sdlc >>>" not in text:
            continue
        head, _, rest = text.partition("# >>> agentic-sdlc >>>")
        _, _, tail = rest.partition("# <<< agentic-sdlc <<<")
        new = (head.rstrip() + "\n" + tail.lstrip("\n")).strip()
        removed.append(f".git/hooks/{name} (our block)")
        if not args.dry_run:
            if new.replace("#!/bin/sh", "").strip():
                open(p, "w").write(new + "\n")
            else:
                os.remove(p)
    verb = "would remove" if args.dry_run else "removed"
    for r in removed:
        print(f"  {verb} {r}")
    print(f"{verb} {len(removed)} item(s)")
    return 0


# ------------------------------------------------------------------- the hybrid retry loop

def cmd_feedback(args) -> int:
    """Carry a gate's failure back to the agent as context, instead of as a dead end.

    A first-pass failure is the normal shape of agentic work; the productive pattern is
    candidate -> deterministic gate -> failure routed back as enriched context -> retry. Without
    somewhere to put that context, each retry starts as ignorant as the attempt before it.
    """
    root = repo_root()
    p = os.path.join(root, FEEDBACK)
    if args.feedback_action == "clear":
        if os.path.exists(p):
            os.remove(p)
        print("feedback cleared")
        return 0
    if args.feedback_action == "read":
        if not os.path.exists(p):
            print("no feedback — this is the first attempt")
            return 0
        d = json.load(open(p))
        print(f"# Attempt {d['attempts'] + 1}. Previous attempts failed as follows — read this "
              f"before changing anything.\n")
        for i, e in enumerate(d["entries"], 1):
            print(f"## Attempt {i} — {e['stage']} ({e['at']})")
            print(e["detail"].strip())
            print()
        return 0
    # write
    d = {"attempts": 0, "entries": []}
    if os.path.exists(p):
        try:
            d = json.load(open(p))
        except Exception:
            pass
    d["attempts"] = d.get("attempts", 0) + 1
    d["entries"] = (d.get("entries") or [])[-4:] + [{
        "stage": args.stage,
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "commit": head(root),
        "detail": args.detail,
    }]
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as fh:
        json.dump(d, fh, indent=2)
    audit(root, "feedback", f"{args.stage}: attempt {d['attempts']}")
    print(f"feedback recorded — attempt {d['attempts']} at stage {args.stage}")
    if d["attempts"] >= 3:
        print("Three attempts at the same stage. Stop and report rather than trying a fourth: "
              "the specification or the approach is probably the problem, not the code.")
    return 0


# ------------------------------------------------------------------------------- governance

def cmd_metrics(args) -> int:
    """What the pipeline actually did — from the audit log, not from anyone's impression."""
    root = repo_root()
    p = os.path.join(root, AUDIT_LOG)
    if not os.path.exists(p):
        print("no audit log yet — it fills as stages run")
        return 0
    rows = []
    for line in open(p, errors="replace"):
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 6:
            rows.append(dict(zip(("at", "event", "commit", "branch", "agent", "detail"), parts)))
    if args.since:
        rows = [r for r in rows if r["at"][:10] >= args.since]
    if not rows:
        print("no events in that window")
        return 0

    stages, blocks, agents = {}, {}, {}
    for r in rows:
        if r["event"].startswith("receipt."):
            kind = r["event"].split(".", 1)[1]
            verdict = r["detail"].split(" by ")[0]
            stages.setdefault(kind, {}).setdefault(verdict, 0)
            stages[kind][verdict] += 1
        elif r["event"] == "blocked":
            blocks[r["detail"][:70]] = blocks.get(r["detail"][:70], 0) + 1
        if r["agent"] != "-":
            agents[r["agent"]] = agents.get(r["agent"], 0) + 1

    print(f"{len(rows)} events from {rows[0]['at'][:10]} to {rows[-1]['at'][:10]}\n")
    print("stage outcomes")
    for kind in RECEIPT_KINDS:
        if kind in stages:
            total = sum(stages[kind].values())
            detail = ", ".join(f"{v} {k}" for k, v in sorted(stages[kind].items()))
            good = stages[kind].get("passed", 0) + stages[kind].get("approved", 0) + \
                stages[kind].get("ready", 0) + stages[kind].get("granted", 0) + \
                stages[kind].get("pass", 0)
            print(f"  {kind:<13} {total:>4} runs   {detail}   first-pass {100 * good // max(total, 1)}%")
    if blocks:
        print("\nrefusals (what the pipeline stopped)")
        for why, n in sorted(blocks.items(), key=lambda x: -x[1])[:10]:
            print(f"  {n:>4}x  {why}")
    if agents:
        print("\nactors")
        for a, n in sorted(agents.items(), key=lambda x: -x[1]):
            print(f"  {a:<24} {n} events")
    print("\nA low first-pass rate is not a problem by itself — it is the gate doing its job.\n"
          "A first-pass rate of 100% means the gate is not checking anything.")
    return 0


def cmd_trace(args) -> int:
    """Requirement -> commit -> test -> pull request, for an auditor or a future maintainer."""
    root = repo_root()
    cfg = load_config(root)
    trunk = cfg.get("trunk", "main")
    base = git("merge-base", "HEAD", f"origin/{trunk}", cwd=root) or \
        git("rev-list", "--max-parents=0", "HEAD", cwd=root)
    commits = [l for l in git("log", "--format=%H|%s", f"{base}..HEAD", cwd=root).splitlines() if l]
    files = [l for l in git("diff", "--name-only", f"{base}..HEAD", cwd=root).splitlines() if l]
    tests = [f for f in files if re.search(r"(^|/)(tests?|spec)/|[._-](test|spec)\.[a-z]+$|_test\.", f)]

    spec_subject = None
    try:
        spec_subject = json.load(open(receipt_path(root, "spec"))).get("subject")
    except Exception:
        pass

    out = {
        "branch": branch(root),
        "head": head(root),
        "base": base,
        "specification": spec_subject,
        "commits": [{"sha": c.split("|")[0][:9], "subject": c.split("|", 1)[1]} for c in commits],
        "files_changed": files,
        "tests_touched": tests,
        "receipts": {},
    }
    for kind in RECEIPT_KINDS:
        rp = receipt_path(root, kind)
        if os.path.exists(rp):
            try:
                r = json.load(open(rp))
                out["receipts"][kind] = {"verdict": r.get("verdict"), "commit": str(r.get("commit"))[:9],
                                         "at": r.get("at"), "by": r.get("by")}
            except Exception:
                pass
    pr = git("config", "--get", "branch.%s.pr" % branch(root), cwd=root)
    if pr:
        out["pull_request"] = pr

    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    print(f"# Traceability — {out['branch']}\n")
    print(f"Specification: {out['specification'] or '(none recorded — the spec receipt is missing)'}")
    print(f"Base: {base[:9]}   Head: {out['head'][:9]}\n")
    print(f"Commits ({len(commits)})")
    for c in out["commits"]:
        print(f"  {c['sha']}  {c['subject'][:90]}")
    print(f"\nFiles changed: {len(files)}   Tests touched: {len(tests)}")
    if files and not tests:
        print("  ⚠ no test file in this change — the verifier should treat every criterion as unexecuted")
    print("\nReceipts")
    for kind, r in out["receipts"].items():
        mark = "current" if r["commit"] == out["head"][:9] else f"stale (for {r['commit']})"
        print(f"  {kind:<13} {r['verdict']:<18} {mark}")
    missing = [k for k in ("spec", "verification", "review", "readiness") if k not in out["receipts"]]
    if missing:
        print(f"\nNo receipt for: {', '.join(missing)} — those stages did not run.")
    return 0


def cmd_approve(args) -> int:
    """A person records that they approved something. Deliberately a human-run command.

    The tool cannot prove a human typed it — nothing short of a signing key can — so it records
    *who claims* the approval, in an append-only log, and makes an unapproved action impossible
    rather than merely discouraged. That is the honest limit of this control.
    """
    root = repo_root()
    if not args.as_person:
        print("sdlc approve needs --as '<your name>' — an approval with no one behind it is "
              "not an approval", file=sys.stderr)
        return 3
    detail = f"{args.what}: {args.detail}" if args.detail else args.what
    rc = receipt_write(root, f"approval_{args.what}", "granted", args.subject or "", detail,
                       args.as_person)
    audit(root, "approval", f"{args.what} granted by {args.as_person}")
    print(f"Recorded: {args.as_person} approved {args.what} at {head(root)[:9]}.\n"
          f"It expires with the next commit, which is the point.")
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(prog="sdlc", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="detect the stack and write sdlc.config.json")
    p.add_argument("--write", action="store_true")
    p.set_defaults(fn=cmd_init)

    sub.add_parser("config", help="print the effective configuration").set_defaults(fn=cmd_config)
    sub.add_parser("status", help="where this unit of work stands").set_defaults(fn=cmd_status)
    g = sub.add_parser("guard", help="PreToolUse hook (stdin JSON; exit 2 blocks)")
    g.add_argument("--command", help="evaluate one shell command instead of reading stdin "
                                     "— this is how the git hooks call it")
    g.set_defaults(fn=cmd_guard)
    sub.add_parser("doctor", help="check the install, the config and the repo").set_defaults(fn=cmd_doctor)

    i = sub.add_parser("install", help="install the pipeline for one or more platforms")
    i.add_argument("targets", nargs="*", help="omit to install for every detected platform")
    i.add_argument("--list", action="store_true", help="what is supported, and what each gets")
    i.add_argument("--dry-run", action="store_true")
    i.add_argument("--no-git-hooks", action="store_true",
                   help="skip the universal git-hook layer (it is installed by default)")
    i.set_defaults(fn=cmd_install)

    u = sub.add_parser("uninstall", help="remove our blocks and the files we own")
    u.add_argument("--dry-run", action="store_true")
    u.set_defaults(fn=cmd_uninstall)

    a = sub.add_parser("approve", help="a person records an approval (merge, release, exception)")
    a.add_argument("what", choices=("merge", "release", "exception"))
    a.add_argument("--as", dest="as_person", help="who is approving — required")
    a.add_argument("--subject", default="")
    a.add_argument("--detail", default="")
    a.set_defaults(fn=cmd_approve)

    f = sub.add_parser("feedback", help="carry a failure back to the next attempt as context")
    fs = f.add_subparsers(dest="feedback_action", required=True)
    fw = fs.add_parser("write")
    fw.add_argument("--stage", required=True)
    fw.add_argument("--detail", required=True)
    fs.add_parser("read")
    fs.add_parser("clear")
    f.set_defaults(fn=cmd_feedback)

    m = sub.add_parser("metrics", help="what the pipeline did, from the audit log")
    m.add_argument("--since", help="YYYY-MM-DD")
    m.set_defaults(fn=cmd_metrics)

    t = sub.add_parser("trace", help="requirement to commit to test to pull request")
    t.add_argument("--json", action="store_true")
    t.set_defaults(fn=cmd_trace)

    r = sub.add_parser("receipt", help="write, show or check a stage receipt")
    rs = r.add_subparsers(dest="receipt_action", required=True)
    for action in ("write", "show", "check"):
        q = rs.add_parser(action)
        q.add_argument("kind", choices=RECEIPT_KINDS)
        q.add_argument("--verdict")
        q.add_argument("--subject", default="")
        q.add_argument("--detail", default="")
        q.add_argument("--by", default=os.environ.get("CLAUDE_AGENT", "agent"))
        q.add_argument("--max-age-min", type=int, default=0)
        q.add_argument("--any-commit", action="store_true",
                       help="do not require the receipt to name the current HEAD")
    r.set_defaults(fn=cmd_receipt)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
