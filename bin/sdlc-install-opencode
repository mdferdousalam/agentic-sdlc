#!/usr/bin/env bash
# Deprecated since 2.1.0 — superseded by `sdlc install opencode`, which is the same code path
# plus the git-hook layer and the marker-guarded AGENTS.md. Kept so existing instructions keep
# working; it will be removed in 3.0.0.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
echo "note: bin/sdlc-install-opencode is deprecated — use: sdlc install opencode" >&2
args=()
for a in "$@"; do case "$a" in --dry-run) args+=(--dry-run);; esac; done
exec python3 "$ROOT/bin/sdlc" install opencode "${args[@]}"
